# 本文件仅用于本机开发示例，不得填入或提交真实 Secret。
# 默认 Compose 启动不启用 mysql profile；本机开发继续使用 127.0.0.1:3306 上的现有 MySQL。
# 如需容器 MySQL，请执行：docker compose --profile mysql up -d
MYSQL_DATABASE=ai_test_platform
MYSQL_USER=test_platform
MYSQL_PASSWORD=test_platform
MYSQL_ROOT_PASSWORD=root_dev_only
RABBITMQ_DEFAULT_USER=test_platform
RABBITMQ_DEFAULT_PASS=test_platform
MINIO_ROOT_USER=test_platform
MINIO_ROOT_PASSWORD=test_platform_dev_only
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
