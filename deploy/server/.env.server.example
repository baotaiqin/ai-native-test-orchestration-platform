# Copy to a protected file outside source control and fill every blank value.
# Backend/Frontend/Demo are supplied by each release package's release.env; leave these three blank here.
# Infrastructure image tags are examples of version families only; pin reviewed immutable tags/digests before production.
BACKEND_IMAGE=
FRONTEND_IMAGE=
DEMO_IMAGE=
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
RABBITMQ_IMAGE=rabbitmq:4.1-management-alpine
MINIO_IMAGE=
PROMETHEUS_IMAGE=

SERVER_BIND_ADDRESS=127.0.0.1
SERVER_HTTP_PORT=8080
RUNNER_BIND_ADDRESS=127.0.0.1
RUNNER_RABBITMQ_PORT=5672
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Use https://demo.example.com behind a TLS reverse proxy for production.
# Direct IP testing can temporarily use http://SERVER_IP:8765.
DEMO_BIND_ADDRESS=0.0.0.0
DEMO_PORT=8765
DEMO_PUBLIC_URL=

MYSQL_DATABASE=ai_test_platform
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Backend uses synchronous SQLAlchemy with the installed PyMySQL driver.
# Example: mysql+pymysql://USER:PASSWORD@mysql:3306/ai_test_platform
APP_DATABASE_URL=

REDIS_PASSWORD=
APP_REDIS_URL=

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
APP_RABBITMQ_URL=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
APP_MINIO_BUCKET=ai-test-evidence

APP_SECRET_KEY=
APP_SECRET_FERNET_KEY_FILE_HOST=
APP_CORS_ORIGINS=
APP_REDIS_KEY_PREFIX=ai-test-platform-server
APP_DEV_ADMIN_USERNAME=admin
APP_DEV_ADMIN_PASSWORD=

# Optional public account shown on the login page for resume/customer demos.
# Its credentials are intentionally browser-visible. Prefer a dedicated demo account.
PUBLIC_DEMO_USERNAME=
PUBLIC_DEMO_PASSWORD=
