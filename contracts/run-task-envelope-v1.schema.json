{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-test-platform:run-task-envelope:v1",
  "title": "Run Task Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "run_id",
    "runner_id",
    "run_type",
    "required_slot_type",
    "attempt",
    "enqueued_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "runner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "run_type": {
      "enum": ["API_CASE", "SCENARIO", "WEB_CASE"]
    },
    "required_slot_type": {
      "enum": ["API", "WEB", "PERFORMANCE"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "enqueued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
