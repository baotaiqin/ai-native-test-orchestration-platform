APP_NAME=AI 原生智能测试编排平台
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=please-change-this-development-key
APP_ACCESS_TOKEN_EXPIRE_MINUTES=120
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_DATABASE_URL=mysql+pymysql://test_platform:test_platform@127.0.0.1:3306/ai_test_platform?charset=utf8mb4
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_RABBITMQ_URL=amqp://test_platform:test_platform@127.0.0.1:5672/
APP_RUNNER_DISCONNECT_SCAN_ENABLED=true
APP_RUNNER_DISCONNECT_SCAN_INTERVAL_SECONDS=30
APP_RUNNER_TOTAL_TIMEOUT_DEFAULT_MS=900000
APP_RUNNER_EXECUTION_TIMEOUT_GRACE_SECONDS=60
APP_SCHEDULE_SCAN_ENABLED=true
APP_SCHEDULE_SCAN_INTERVAL_SECONDS=30
APP_WEBHOOK_SCAN_ENABLED=true
APP_WEBHOOK_SCAN_INTERVAL_SECONDS=15
APP_METRICS_ENABLED=true
APP_MINIO_ENDPOINT=127.0.0.1:9000
APP_MINIO_ACCESS_KEY=test_platform
APP_MINIO_SECRET_KEY=test_platform_dev_only
APP_DEV_ADMIN_USERNAME=admin
APP_DEV_ADMIN_PASSWORD=admin123
